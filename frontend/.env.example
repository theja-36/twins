# Server-side only. NONE of these is ever sent to the browser (no NEXT_PUBLIC_ variable is used for secrets or the API address).
# The TWINS API address on the PRIVATE network. The browser never calls it.
TWINS_API_BASE_URL=http://127.0.0.1:3000
# "host" (default, REQUIRED in any deployment): __Host- cookies, Secure, HSTS. Needs HTTPS and Path=/.
# "dev": plain cookie names, not Secure, so http://localhost works. In a production build it is refused unless TWINS_ALLOW_INSECURE_COOKIES=true (used only by the e2e run).
TWINS_COOKIE_MODE=dev
# TWINS_ALLOW_INSECURE_COOKIES=true
# The public origin as the browser sees it (scheme://host[:port]). Used by the fail-closed same-origin check. Required in host mode.
# TWINS_PUBLIC_ORIGIN=https://desk.example.com
# Name of the header the TRUSTED reverse proxy sets with the client address (e.g. x-forwarded-for). Unset: all clients share one throttle bucket (safe, but one source can throttle everyone).
# TWINS_TRUST_PROXY_HEADER=x-forwarded-for
# Render the design-system gallery at /design-system (development and CI only).
# TWINS_ENABLE_DESIGN_GALLERY=true
