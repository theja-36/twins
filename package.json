{
  "name": "twins",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "TWINS - independent AI-assisted signal validation and risk management platform",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "adapters/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "scan:secrets": "node scripts/ci/secret-scan.mjs",
    "audit:verify": "tsx scripts/ops/verify-audit-chain.ts",
    "safety:control": "tsx scripts/ops/safety-control.ts",
    "risk:control": "tsx scripts/ops/risk-control.ts",
    "historical:import": "tsx scripts/ops/historical-import.ts",
    "historical:evaluate": "tsx scripts/ops/historical-evaluate.ts",
    "historical:scorecard": "tsx scripts/ops/historical-scorecard.ts",
    "historical:patterns": "tsx scripts/ops/historical-patterns.ts",
    "intelligence": "tsx scripts/ops/source-intelligence.ts",
    "agents:snapshots": "tsx scripts/ops/agent-snapshots.ts",
    "options:preview": "tsx scripts/options-preview.ts",
    "options:viewer": "tsx apps/web/src/server.ts",
    "options:demo": "tsx scripts/options-demo.ts",
    "options:import-dhan": "tsx scripts/options-import-dhan.ts",
    "format": "prettier --write .",
    "offhost": "tsx scripts/ops/offhost-backup.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.5"
  }
}
