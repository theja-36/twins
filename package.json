{
  "name": "twins",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "TWINS - independent AI-assisted signal validation and risk management platform",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "adapters/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "options:preview": "tsx scripts/options-preview.ts",
    "options:viewer": "tsx apps/web/src/server.ts",
    "options:demo": "tsx scripts/options-demo.ts",
    "options:import-dhan": "tsx scripts/options-import-dhan.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^7.0.2",
    "vitest": "^2.0.0"
  }
}
