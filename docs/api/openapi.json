    "/risk/decisions/{id}/approval": {
      "post": {
        "tags": [
          "risk"
        ],
        "summary": "Record APPROVE or REJECT of the decision version (the database re-checks every gate). Creates NO order.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action",
                  "actor"
                ],
                "properties": {
                  "action": {
                    "enum": [
                      "APPROVE",
                      "REJECT"
                    ]
                  },
                  "actor": {
                    "type": "string",
                    "pattern": "^operator:[A-Za-z0-9._-]{1,64}$"
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "recorded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "invalid_input"
          },
          "401": {
            "description": "Unauthorized (missing or wrong bearer token)"
          },
          "409": {
            "description": "duplicate or refused"
          },
          "500": {
            "description": "internal_error (fixed body; details are in the server log)"
          }
        }
      }
    },
