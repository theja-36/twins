                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "invalid_input"
          },
          "401": {
            "description": "Unauthorized (missing or wrong bearer token)"
          },
          "500": {
            "description": "internal_error (fixed body; details are in the server log)"
