    "/admin/paper/switch": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Turn the audited paper-trading switch on or off (needs the admin token; has no effect unless the host has armed paper trading; enabling is refused while the live-trading guard fails)",
        "security": [
          {
            "adminBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "enabled",
                  "actor",
                  "reason"
                ],
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "actor": {
                    "type": "string",
                    "pattern": "^(operator|service):[A-Za-z0-9._-]{1,64}$"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "unchanged",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "201": {
            "description": "enabled or disabled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "invalid_input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "409": {
            "description": "live_trading_guard_failed"
          },
          "500": {
            "description": "internal_error"
          }
        }
      }
    },
