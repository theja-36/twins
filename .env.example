# TWINS environment configuration template.
# Copy to .env.<environment> (development / staging / production).
# NEVER commit real values. NEVER share credentials across environments.

# --- Environment / mode -----------------------------------------------
NODE_ENV=development
APP_ENV=development
# paper | shadow | live
TRADING_MODE=paper
# Master safety switch. Must be explicitly and manually set to true.
# Never enable via code, AI, or automated deploy.
LIVE_TRADING=false

# --- Database ------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/twins_dev
REDIS_URL=redis://localhost:6379

# --- AI provider (OpenRouter) --------------------------------------------
OPENROUTER_API_KEY=
AI_DAILY_BUDGET_USD=
AI_MONTHLY_BUDGET_USD=

# --- Broker (adapter-specific, do not hard-code a single broker) --------
BROKER_PROVIDER=
BROKER_API_KEY=
BROKER_API_SECRET=

# --- Telegram -------------------------------------------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=

# --- Market / macro / news data providers --------------------------------
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=
NEWS_PROVIDER_API_KEY=
MACRO_DATA_PROVIDER=

# --- Infra ------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
COOLIFY_API_TOKEN=

# --- Phase 1 new env vars -----------------------------------------------
# API key for operator-facing endpoints (must be set for /signals/:id/validation)
TWINS_API_KEY=
# Secret token that Telegram will include in X-Telegram-Bot-Api-Secret-Token header
TELEGRAM_WEBHOOK_SECRET=
# Exchange used when parsing symbols from Telegram messages
TELEGRAM_SIGNAL_EXCHANGE=NSE
# Instrument type for signals coming from Telegram (e.g., equity, futures)
TELEGRAM_SIGNAL_INSTRUMENT_TYPE=equity
# Watchlist for market data fetches (comma-separated SYMBOL:EXCHANGE pairs)
MARKET_WATCHLIST=RELIANCE.NS:NSE,INFY.NS:NSE,TCS.NS:NSE,^NSEI:INDEX
# Cron expression for market data scheduler (default 9:30 IST weekdays)
MARKET_CRON_EXPRESSION="0 4 * * 1-5"
# Number of days of lookback for historical bars
MARKET_LOOKBACK_DAYS=7
# Preferred market data provider (must match registered adapter name)
MARKET_DATA_PROVIDER=yahoo-finance
# Instrument type for market data (equity, index, etc.)
MARKET_INSTRUMENT_TYPE=equity
