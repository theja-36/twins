# TWINS staging environment TEMPLATE. Placeholders only. Copy to infrastructure/staging/staging.env (git-ignored via
# .gitignore `*.env` rules in .dockerignore and `.env.*`) and fill with NEW random values generated on the server.
# Never reuse a value from another environment (dev/CI/rehearsal) and never commit the filled file.
# Use letters and digits only in passwords (they are embedded in connection URLs; no URL-encoding is applied).

POSTGRES_DB=twins_staging
POSTGRES_USER=twins_staging
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
REDIS_PASSWORD=CHANGE_ME_redis_password
# Password of the least-privilege RUNTIME database role twins_app used by api, worker and scheduler (create the role and run
# infrastructure/staging/app-role.sql as the owner after every migration). The owner credential above is used only by migrate, safety-control and audit-verify.
TWINS_APP_DB_PASSWORD=CHANGE_ME_app_role_password

# Operator bearer token for /signals/:id/validation and /options-claims/:messageId.
TWINS_API_KEY=CHANGE_ME_api_key
# Telegram webhook secret the API REQUIRES at startup (fail-closed). No Telegram registration is performed by this stack.
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_telegram_webhook_secret

# Telegram intake allowlist for the API AND the worker. Leave EMPTY: an empty value approves NO chat (deny by default).
# The numeric id of the single approved test chat/channel is added here later, under a separate approval, as a canonical
# integer (e.g. -1001234567890; digits only, optional leading '-'; comma-separated for several; no names or wildcards). A malformed
# value makes the API and worker refuse to start. TWINS_TELEGRAM_OPTIONS_ONLY is fixed to "true" in the compose file.
TWINS_TELEGRAM_ALLOWED_CHAT_IDS=

# Token of the INTERNAL User API capture endpoint. Leave EMPTY: an empty value means the endpoint does not exist. It is set only
# when the read-only capture service is deployed (a separate, approved step): 32+ random characters of A-Z a-z 0-9 _ - + = . ~,
# different from TWINS_API_KEY and TELEGRAM_WEBHOOK_SECRET. Never routed through the reverse proxy. Given to the API and the capture client only.
TWINS_CAPTURE_INGEST_TOKEN=

# Capture client (profile `capture`; owner-supplied, never in the repo). Leave EMPTY until the owner approves the capture login:
# TWINS_TELEGRAM_API_ID (digits), TWINS_TELEGRAM_API_HASH (32 hex), TWINS_TELEGRAM_SESSION_DB_KEY (64 hex).
TWINS_TELEGRAM_API_ID=
TWINS_TELEGRAM_API_HASH=
TWINS_TELEGRAM_SESSION_DB_KEY=

# Image tag the app services run (api, worker, scheduler, migrate). Optional: default `local`. Set to the unique tag of a newly
# built image to deploy it; go back to `local` (the previous image) to roll back. Not a secret.
# TWINS_IMAGE_TAG=local
# Optional, capture service only: its own image tag (unset = TWINS_IMAGE_TAG). Delete the line to roll the capture client back.
# TWINS_CAPTURE_IMAGE_TAG=

# Loopback port on the HOST for the private API (published as 127.0.0.1:<port> only).
TWINS_API_HOST_PORT=4110

# Not set here on purpose: LIVE_TRADING / TRADING_MODE / APP_ENV (fixed in the compose file), TELEGRAM_BOT_TOKEN,
# any market/news/macro/broker/AI keys, TWINS_OPTIONS_MANUAL_REFERENCE, TWINS_OPTIONS_PROVIDER_SNAPSHOT.

# ── Operational alerting (Stage 2 / Task 5; docs/twins/OPERATIONAL_ALERTING.md) ──
# The application containers never see the webhook: they post to the alert-relay service with TWINS_ALERT_RELAY_TOKEN (>= 24 random characters),
# and the relay alone holds TWINS_ALERT_WEBHOOK_URL (a credential: webhook URLs embed a token). Leave the webhook empty = alerts are logged as undelivered.
TWINS_ALERT_RELAY_TOKEN=CHANGE_ME_random_24plus_characters
TWINS_ALERT_WEBHOOK_URL=
TWINS_ALERT_WEBHOOK_SECRET=
