# Approval bot environment (T5). Copy to /opt/twins-staging/infrastructure/staging/bot.env on the HOST (chmod 600, owner root) and fill it there.
# NEVER commit the filled file. Only the approval-bot service reads it. Values are entered by the owner in their own SSH session (silent prompts).
TWINS_BOT_TOKEN=
TWINS_BOT_APPROVER_ID=
TWINS_BOT_DATABASE_URL=
TWINS_BOT_HMAC_KEY=
TWINS_BOT_SOURCE_CHANNELS=
TWINS_BOT_CHANNEL_LABEL=
# Off until the owner says go. The service also needs to be started.
TWINS_BOT_ACTIVE=false
# Optional tuning (defaults: card TTL 14400 s, poll 30 s, 5 per cycle, 20 per hour, 100 per day)
# TWINS_BOT_CARD_TTL_SECONDS=14400
# TWINS_BOT_POLL_INTERVAL_SECONDS=30
