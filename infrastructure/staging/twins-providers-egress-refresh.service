# One refresh of the providers address set, then the staleness check. Run every 30 seconds by twins-providers-egress-refresh.timer. NOT INSTALLED.
[Unit]
Description=TWINS providers egress address-set refresh
After=twins-providers-egress.service
OnFailure=twins-alert-on-failure@%n.service

[Service]
Type=oneshot
ExecStart=/opt/twins-staging/twins-providers-egress.sh refresh
ExecStartPost=/opt/twins-staging/twins-providers-egress.sh check-stale
TimeoutStartSec=30
Nice=5
