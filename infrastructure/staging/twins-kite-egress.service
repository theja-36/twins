# Applies the Kite-only egress rules for the Kite network (10.0.28.0/24) at boot and whenever Docker restarts. NOT INSTALLED. Install only with the Kite feed (see docs/twins/KITE_EGRESS_ALLOWLIST_DESIGN.md):
# copy to /etc/systemd/system/, `systemctl daemon-reload && systemctl enable --now twins-kite-egress twins-kite-egress-refresh.timer`.
# `systemctl stop` (or disable) REMOVES the rules: only do that while the Kite feed is stopped.
[Unit]
Description=TWINS Kite egress allow-list (api.kite.trade, ws.kite.trade; 10.0.28.0/24)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=90
# A leftover chain (for example from a manual apply) is removed first; `apply` itself refuses to touch an existing chain.
ExecStartPre=-/opt/twins-staging/twins-kite-egress.sh remove
ExecStart=/opt/twins-staging/twins-kite-egress.sh apply
# The unit fails (and the problem is visible) unless the chain, the set and a fresh refresh are all in place.
ExecStartPost=/opt/twins-staging/twins-kite-egress.sh status
ExecStop=/opt/twins-staging/twins-kite-egress.sh remove

[Install]
WantedBy=multi-user.target
