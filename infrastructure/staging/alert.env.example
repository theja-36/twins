# /etc/twins-alerts/alert.env on the HOST (root:root 0600), read by twins-alert.sh for host-side jobs (backup, backup verification, health check, systemd OnFailure).
# The webhook URL is a credential: never commit the real file. Values below are placeholders.
TWINS_ALERT_WEBHOOK_URL=https://CHANGE_ME.example/hook/CHANGE_ME
TWINS_ALERT_WEBHOOK_SECRET=CHANGE_ME_optional_hmac_secret
TWINS_ENV_NAME=staging
TWINS_BUILD=CHANGE_ME_commit_or_image_tag
