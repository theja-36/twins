# /etc/twins-recovery/drill.env on the RECOVERY host (root:twins-recovery 0640). The recovery host holds the PRIVATE key FILE and a READ-ONLY bucket credential.
# Never commit the real file. Values below are placeholders.
TWINS_BACKUP_ENV_NAME=staging
TWINS_BACKUP_S3_ENDPOINT=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
TWINS_BACKUP_S3_BUCKET=CHANGE_ME_BUCKET
TWINS_BACKUP_S3_ACCESS_KEY_ID=CHANGE_ME
TWINS_BACKUP_S3_SECRET_ACCESS_KEY=CHANGE_ME
# Path to the age identity file (AGE-SECRET-KEY-1...), mode 0400. Only the PATH is configured here, never the key.
TWINS_BACKUP_AGE_IDENTITY_FILE=/etc/twins-recovery/age-identity.txt
TWINS_BACKUP_RUNNER_LABEL=recovery-host
TWINS_BACKUP_REPO_DIR=/opt/twins-recovery
TWINS_BACKUP_DRILL_WORK_DIR=/var/lib/twins-backup/drill
TWINS_BACKUP_STATUS_DIR=/var/lib/twins-monitor
