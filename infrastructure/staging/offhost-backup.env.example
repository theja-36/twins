# /etc/twins-backup/offhost.env on the BACKUP host (root:twins-backup 0640). Read by systemd (EnvironmentFile=); NOT passed to the application containers.
# Contains a storage credential and a database credential: never commit the real file, never print it. Values below are placeholders.
TWINS_BACKUP_ENV_NAME=staging
# Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com (S3 API). Bucket is PRIVATE; this token is scoped to this one bucket.
TWINS_BACKUP_S3_ENDPOINT=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
TWINS_BACKUP_S3_BUCKET=CHANGE_ME_BUCKET
TWINS_BACKUP_S3_ACCESS_KEY_ID=CHANGE_ME
TWINS_BACKUP_S3_SECRET_ACCESS_KEY=CHANGE_ME
# The PUBLIC age recipient (age1...). The private key is never on this host.
TWINS_BACKUP_AGE_RECIPIENT=age1CHANGE_ME
# Database to snapshot (owner or a role that can run pg_dump). PostgreSQL inside the staging compose network is reached through its container:
TWINS_BACKUP_DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@127.0.0.1:5432/CHANGE_ME
TWINS_BACKUP_PG_CONTAINER=twins-staging-postgres-1
TWINS_BACKUP_ANCHOR_FILE=/var/lib/twins-monitor/audit-anchor.json
TWINS_BACKUP_SPOOL_DIR=/var/lib/twins-backup/spool
TWINS_BACKUP_MANIFEST_LOG=/var/lib/twins-backup/manifest.jsonl
TWINS_BACKUP_STATUS_DIR=/var/lib/twins-monitor
# Retention (defaults shown): 7 daily, 4 weekly, 6 monthly; never fewer than 3 per class; nothing younger than 48 h.
TWINS_BACKUP_KEEP_DAILY=7
TWINS_BACKUP_KEEP_WEEKLY=4
TWINS_BACKUP_KEEP_MONTHLY=6
